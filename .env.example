# URL of your backend API (without trailing slash)
# Example: http://localhost:5000
# Ensure this matches the port your backend server is running on.
VITE_BACKEND_URL=http://localhost:5000

# Cloudflare Turnstile Site Key (get from Cloudflare Dashboard -> Turnstile)
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY_HERE

# Dev only: force the visitor region (ISO 3166-1 code, e.g. IN) for
# region-aware lists like Now Playing. Local dev has no IP geolocation,
# so without this the region falls back to the browser locale.
# VITE_DEV_REGION=IN
